EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Voice chat (optional) -------------------------------------------------
# Voice is peer-to-peer WebRTC and works over plain STUN for most players.
# Players behind symmetric NAT or strict mobile carriers need a TURN relay.
# Any provider works (Twilio, Metered, Cloudflare, self-hosted coturn).
# EXPO_PUBLIC_TURN_URL=turn:your-turn-host:3478
# EXPO_PUBLIC_TURN_USERNAME=your_turn_username
# EXPO_PUBLIC_TURN_CREDENTIAL=your_turn_credential
